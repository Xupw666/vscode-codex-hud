{
  "name": "codex-hud",
  "displayName": "Codex HUD",
  "description": "A VS Code companion panel for Codex context management and usage visualization.",
  "version": "0.0.1",
  "publisher": "local",
  "icon": "media/codex.svg",
  "license": "UNLICENSED",
  "keywords": [
    "codex",
    "context",
    "usage",
    "statusbar",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "scripts": {
    "check": "node --check extension.js && node --check quickLauncher.js && node --check petAutoWake.js && node --check desktopPet.js && node --check codexNotifications.js && node --check media/view.js",
    "build:desktop-pet": "clang -fobjc-arc desktop-pet/DuoTuanPet.m -framework Cocoa -o desktop-pet/DuoTuanPet",
    "test": "node --test"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:codexHud.dashboard",
    "onView:codexHud.quickLauncher",
    "onCommand:codexHud.openPanel",
    "onCommand:codexHud.quickOpenCodexAgent",
    "onCommand:codexHud.openThreeCodexAgents",
    "onCommand:codexHud.openFourCodexAgents",
    "onCommand:codexHud.enablePetAutoWake",
    "onCommand:codexHud.disablePetAutoWake",
    "onCommand:codexHud.repairPetAutoWake",
    "onCommand:codexHud.refreshUsage",
    "onCommand:codexHud.captureSelection",
    "onCommand:codexHud.setSessionUsage",
    "onCommand:codexHud.setWeeklyUsage",
    "onCommand:codexHud.clearContext",
    "onCommand:codexHud.refreshFromClipboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexHud.openPanel",
        "category": "Codex HUD",
        "title": "Open Panel"
      },
      {
        "command": "codexHud.captureSelection",
        "category": "Codex HUD",
        "title": "Capture Selection as Context"
      },
      {
        "command": "codexHud.quickOpenCodexAgent",
        "category": "Codex HUD",
        "title": "Open Another Codex Agent"
      },
      {
        "command": "codexHud.openThreeCodexAgents",
        "category": "Codex HUD",
        "title": "Open 3 Codex Agents"
      },
      {
        "command": "codexHud.openFourCodexAgents",
        "category": "Codex HUD",
        "title": "Open 4 Codex Agents"
      },
      {
        "command": "codexHud.enablePetAutoWake",
        "category": "Codex HUD",
        "title": "Enable Pet Auto Wake"
      },
      {
        "command": "codexHud.disablePetAutoWake",
        "category": "Codex HUD",
        "title": "Disable Pet Auto Wake"
      },
      {
        "command": "codexHud.repairPetAutoWake",
        "category": "Codex HUD",
        "title": "Repair Pet Auto Wake"
      },
      {
        "command": "codexHud.refreshUsage",
        "category": "Codex HUD",
        "title": "Refresh Usage from Codex"
      },
      {
        "command": "codexHud.setSessionUsage",
        "category": "Codex HUD",
        "title": "Set Session Usage"
      },
      {
        "command": "codexHud.setWeeklyUsage",
        "category": "Codex HUD",
        "title": "Set Weekly Usage"
      },
      {
        "command": "codexHud.clearContext",
        "category": "Codex HUD",
        "title": "Clear Stored Context"
      },
      {
        "command": "codexHud.refreshFromClipboard",
        "category": "Codex HUD",
        "title": "Refresh CC Usage from Clipboard (/usage)"
      }
    ],
    "configuration": {
      "title": "Codex HUD",
      "properties": {
        "codexHud.session.usedPercent": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Current session usage percentage."
        },
        "codexHud.session.resetAt": {
          "type": "string",
          "default": "",
          "description": "Free-form label for the current session reset time."
        },
        "codexHud.weekly.usedPercent": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Current week usage percentage."
        },
        "codexHud.weekly.resetAt": {
          "type": "string",
          "default": "",
          "description": "Free-form label for the weekly reset time."
        },
        "codexHud.extraUsageEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether extra usage is enabled."
        },
        "codexHud.extraUsageLabel": {
          "type": "string",
          "default": "Extra usage not enabled",
          "description": "Description shown for extra usage status."
        },
        "codexHud.contextWindow.limitTokens": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "description": "Estimated context window limit in tokens."
        },
        "codexHud.contextWindow.baseTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Reserved tokens for prompts or hidden context not managed by this panel."
        },
        "codexHud.contextWindow.warnAtPercent": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "Warning threshold for context window usage."
        },
        "codexHud.tokenEstimateCharsPerToken": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "Rough token estimation ratio used for background context entries."
        },
        "codexHud.openPanelOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time install prompt that opens the Codex HUD bottom panel."
        },
        "codexHud.autoSyncFromCodexRollouts": {
          "type": "boolean",
          "default": true,
          "description": "Automatically read real usage and token data from the latest local Codex rollout."
        },
        "codexHud.rolloutRefreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 3600,
          "description": "How often Codex HUD refreshes rollout-derived usage data."
        },
        "codexHud.codexHomePath": {
          "type": "string",
          "default": "~/.codex",
          "description": "Path to the local Codex home directory used for rollout history."
        },
        "codexHud.claudeCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read context and session usage from Claude Code (~/.claude) when Codex rollout data is unavailable."
        },
        "codexHud.claudeCode.homePath": {
          "type": "string",
          "default": "~/.claude",
          "description": "Path to the Claude Code home directory."
        },
        "codexHud.claudeCode.sessionTokenLimit": {
          "type": "number",
          "default": 8000000,
          "minimum": 10000,
          "description": "Estimated 5-hour token limit for Claude Code session usage. Max(5x) plan ≈ 8000000. Standard plan ≈ 1000000."
        },
        "codexHud.claudeCode.contextWindowTokens": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "Context window size in tokens for the Claude Code model (200k for claude-sonnet-4-6)."
        },
        "codexHud.claudeCode.weeklyTokenLimit": {
          "type": "number",
          "default": 50000000,
          "minimum": 10000,
          "description": "Estimated weekly token budget for Claude Code (last 7 days). Max(5x) plan ≈ 50000000. Standard plan ≈ 7000000."
        },
        "codexHud.petAutoWake.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically keep the local Codex pet wake patch applied on VS Code startup."
        },
        "codexHud.petAutoWake.petSlug": {
          "type": "string",
          "default": "duotuan",
          "description": "Folder name under ~/.codex/pets or bundled pets/ for the pet that should wake by default."
        },
        "codexHud.petAutoWake.petId": {
          "type": "string",
          "default": "custom:duotuan",
          "description": "OpenAI Codex avatar id to select by default when waking the pet."
        },
        "codexHud.petAutoWake.desktopPet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Launch the draggable desktop pet helper when Codex auto wake is enabled."
        },
        "codexHud.petAutoWake.desktopPet.size": {
          "type": "number",
          "default": 160,
          "minimum": 96,
          "maximum": 280,
          "description": "Default desktop pet width in pixels. The pet keeps its Codex 192:208 sprite ratio."
        },
        "codexHud.petAutoWake.notificationMode": {
          "type": "string",
          "default": "critical",
          "enum": [
            "critical",
            "progress"
          ],
          "enumDescriptions": [
            "Only show desktop pet bubbles when Codex needs confirmation or a task completes.",
            "Also show task start and throttled progress bubbles."
          ],
          "description": "Desktop pet notification mode."
        },
        "codexHud.petAutoWake.webviewOverlay.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Also inject an in-webview pet fallback inside Codex panels."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexHudLauncher",
          "title": "Codex +",
          "icon": "media/blossom-white.svg"
        }
      ],
      "panel": [
        {
          "id": "codexHudPanel",
          "title": "Codex HUD",
          "icon": "media/codex.svg"
        }
      ]
    },
    "views": {
      "codexHudLauncher": [
        {
          "id": "codexHud.quickLauncher",
          "name": "Quick Launch"
        }
      ],
      "codexHudPanel": [
        {
          "type": "webview",
          "id": "codexHud.dashboard",
          "name": "Codex HUD"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexHud.quickOpenCodexAgent",
          "when": "view == codexHud.quickLauncher",
          "group": "navigation"
        }
      ]
    }
  }
}
